{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": { "root": "apps/web/" },
    "api": { "root": "apps/api/", "entrypoint": "src/main.ts" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [{ "path": "/api/cron/sweep", "schedule": "0 4 * * *" }]
}
