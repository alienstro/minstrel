# Spec §2.5. Local values for `pnpm dev:vercel`. On Vercel, the project settings hold these values.
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Neon sets both on Vercel. Locally, both point at the Docker Postgres (docker compose up -d db).
DATABASE_URL=postgres://minstrel:minstrel@localhost:5433/minstrel
DATABASE_URL_UNPOOLED=postgres://minstrel:minstrel@localhost:5433/minstrel
TEST_DATABASE_URL=postgres://minstrel:minstrel@localhost:5433/minstrel_test

# 32+ random bytes each: openssl rand -base64 32
CRON_SECRET=
BETTER_AUTH_SECRET=

# Master keys for provider keys, "<version>:<base64 32 bytes>". The highest version encrypts.
KEY_ENCRYPTION_KEYS=1:

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

LOG_LEVEL=info
