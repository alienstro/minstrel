# Spec §2.5. Local values for `pnpm dev`. In production, the Dokploy app `minstrel-api` holds these values.
# The API Docker image sets NODE_ENV=production and PORT=4000.
PORT=4000
WEB_ORIGIN=http://localhost:3000

# On Dokploy, both are the internal URL of the database `minstrel-db`. Locally, both point at the
# Docker Postgres (docker compose up -d db). The migrations use DATABASE_URL_UNPOOLED when it is set.
DATABASE_URL=postgres://minstrel:minstrel@localhost:5433/minstrel
DATABASE_URL_UNPOOLED=postgres://minstrel:minstrel@localhost:5433/minstrel
TEST_DATABASE_URL=postgres://minstrel:minstrel@localhost:5433/minstrel_test

# 32+ random bytes each: openssl rand -base64 32
CRON_SECRET=
BETTER_AUTH_SECRET=

# Master keys for provider keys, "<version>:<base64 32 bytes>". The highest version encrypts.
# Warning: keep a copy of the production BETTER_AUTH_SECRET and KEY_ENCRYPTION_KEYS outside the
# server, for example in a password manager. Without KEY_ENCRYPTION_KEYS, a restored database has
# provider keys that nobody can read (docs/deploy.md, "Keep a copy of the secrets").
KEY_ENCRYPTION_KEYS=1:

# Locally, the OAuth client "Minstrel local" (http://localhost:3000). In production, "Minstrel production".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Locally, the bucket minstrel-audio-dev. In production, minstrel-audio. Each token has access to one bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

LOG_LEVEL=info

# Only for the local end-to-end test: a fake kie provider. The API does not start with it when
# NODE_ENV=production.
# MINSTREL_FAKE_PROVIDERS=1

# Deploy values (docs/deploy.md). The API does not read them. A password manager is the better place
# for them. If you keep them in this file, use these names, so that they never replace the app values
# above.
# DOKPLOY_KEY=
# CLOUDFLARE_TUNNEL_TOKEN=
# R2_BACKUP_ACCESS_KEY_ID=
# R2_BACKUP_SECRET_ACCESS_KEY=
# PROD_R2_ACCESS_KEY_ID=
# PROD_R2_SECRET_ACCESS_KEY=
# PROD_GOOGLE_CLIENT_SECRET=
